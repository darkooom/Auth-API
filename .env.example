PORT=5000
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
NODE_ENV=development
TRUST_PROXY=
API_KEY=replace-with-random-api-key

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=auth_api
DB_USER=postgres
DB_PASS=postgres
DB_POOL_MAX=10

JWT_ACCESS_SECRET=replace-with-a-unique-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
REQUIRE_EMAIL_VERIFICATION=true

# SMTP is required in production for verification and password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Auth API <no-reply@example.com>
