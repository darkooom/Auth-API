    "secure",
    "jwt",
    "postgres"
  ],
  "author": "NotNexx",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/NotNexx/Auth-API/issues"
  },
  "homepage": "https://github.com/NotNexx/Auth-API#readme",
  "dependencies": {
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
